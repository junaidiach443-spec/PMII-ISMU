# Salin file ini menjadi .env atau buat api/config.local.php
# JANGAN PERNAH mengunggah file .env yang berisi password asli ke Git/GitHub!

# Pilihan 1: PostgreSQL Cloud (Neon.tech / Supabase)
# DATABASE_URL=postgresql://neondb_owner:PASSWORD_ANDA@ep-xxx.neon.tech/neondb?sslmode=require

# Pilihan 2: MySQL Local (XAMPP)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=db_pmii_ismu
DB_USER=root
DB_PASS=

